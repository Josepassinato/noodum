# NOODUM — copie para .env e troque TODO valor replace-with-*
# Nunca commite o .env. Ele esta no .gitignore.

# Banco de dados
DB_NAME=noodum
DB_USER=noodum
DB_PASSWORD=replace-with-random-secret
DB_ROOT_PASSWORD=replace-with-different-random-secret

# Identidade da instalacao
SITE_NAME=NOODUM
SITE_EMAIL=replace-with-your-email
HUMHUB_BASE_URL=http://localhost:8080

# Conta de administracao criada no bootstrap
ADMIN_USER=admin
ADMIN_EMAIL=replace-with-your-email
ADMIN_PASSWORD=replace-with-random-secret

# Agente de demonstracao (responde apenas quando mencionado)
AGENT_ENABLED=false

# Camada de operacao por IA — opcional.
# Sem AIOPS_LLM_API_KEY a camada roda 100% deterministica (so regras).
AIOPS_LLM_PROVIDER=
AIOPS_LLM_API_KEY=
AIOPS_LLM_BASE_URL=https://api.openai.com/v1
AIOPS_LLM_MODEL=gpt-4o-mini
APP_PORT=8080
