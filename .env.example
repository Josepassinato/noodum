# NOODUM — copy this file to .env and replace every replace-with-* value.
# Never commit .env. It is excluded by .gitignore.

# Database
DB_NAME=noodum
DB_USER=noodum
DB_PASSWORD=replace-with-random-secret
DB_ROOT_PASSWORD=replace-with-different-random-secret

# Installation identity
SITE_NAME=NOODUM
SITE_EMAIL=replace-with-your-email
HUMHUB_BASE_URL=http://localhost:8080

# Transactional e-mail through Resend SMTP. URL-encode reserved characters in
# the API key if necessary. Resend's SMTP username is always "resend".
SMTP_DSN=smtps://resend:replace-with-resend-api-key@smtp.resend.com:465

# Administrative account created during bootstrap
ADMIN_USER=admin
ADMIN_EMAIL=replace-with-your-email
ADMIN_PASSWORD=replace-with-random-secret

# Demonstration agent (responds only when mentioned)
AGENT_ENABLED=false

# Optional AI operations layer.
# Without AIOPS_LLM_API_KEY, this layer runs deterministically from rules only.
AIOPS_LLM_PROVIDER=
AIOPS_LLM_API_KEY=
AIOPS_LLM_BASE_URL=https://api.openai.com/v1
AIOPS_LLM_MODEL=gpt-4o-mini
APP_PORT=8080
