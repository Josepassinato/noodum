# NOODUM — copy this file to .env and replace every replace-with-* value.
# Never commit .env. It is excluded by .gitignore.
# Leave secrets blank until you have them. Empty keys disable that feature.

# Database
DB_NAME=noodum
DB_USER=noodum
DB_PASSWORD=replace-with-random-secret
DB_ROOT_PASSWORD=replace-with-different-random-secret

# Installation identity. Use addresses you control. These are not live secrets.
SITE_NAME=NOODUM
SITE_EMAIL=replace-with-your-email
HUMHUB_MAIL_FROM_NAME=NOODUM
HUMHUB_BASE_URL=http://localhost:8080
APP_PORT=8080

# Transactional e-mail. Resend's SMTP username is the literal word "resend".
# URL-encode reserved characters in the API key. Leave blank to skip mail.
SMTP_DSN=

# Administrative account created during bootstrap
ADMIN_USER=admin
ADMIN_EMAIL=replace-with-your-email
ADMIN_PASSWORD=replace-with-random-secret

# Demonstration agent. It replies only when mentioned, and only if this is true.
AGENT_ENABLED=false

# Optional acknowledgement on unanswered public posts. Off unless both flags
# are true. Set the two text fields only if you want that public wording.
COVER_ENABLED=false
NOODUM_OPERATOR_NAME=
NOODUM_COVER_ACK=

# Usernames allowed to unpublish example seed posts. Comma-separated.
NOODUM_SEED_USERNAMES=12Brain,noodum_notes,demo_agent

# Three-provider operations council. A member is configured only when both
# its API key and model are present. Keep real credentials in .env only.
AIOPS_OPENAI_API_KEY=
AIOPS_OPENAI_MODEL=
AIOPS_OPENAI_BASE_URL=https://api.openai.com/v1
AIOPS_XAI_API_KEY=
AIOPS_XAI_MODEL=
AIOPS_XAI_BASE_URL=https://api.x.ai/v1
AIOPS_GEMINI_API_KEY=
AIOPS_GEMINI_MODEL=
AIOPS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Backward-compatible single-provider mode. It does not count as a council.
AIOPS_LLM_PROVIDER=
AIOPS_LLM_API_KEY=
AIOPS_LLM_BASE_URL=https://api.openai.com/v1
AIOPS_LLM_MODEL=

# Optional private Telegram channel for the operator. Leave disabled until
# you have a new bot token, a random webhook secret, and an allowlist.
NOODUM_TELEGRAM_ENABLED=false
NOODUM_TELEGRAM_BOT_TOKEN=
NOODUM_TELEGRAM_WEBHOOK_SECRET=
NOODUM_TELEGRAM_ALLOWED_CHAT_IDS=
NOODUM_TELEGRAM_WEBHOOK_URL=
